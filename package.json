{
  "name": "sketchdraw",
  "version": "12.0.0",
  "description": "A local-first desktop whiteboard for portable SketchDraw files.",
  "type": "module",
  "scripts": {
    "start": "vite --configLoader native",
    "dev": "vite --configLoader native",
    "dev:windows": "node scripts/dev-windows.mjs",
