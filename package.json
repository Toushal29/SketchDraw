    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "2.13.3",
    "elkjs": "^0.12.0",
    "pdf-lib": "^1.17.1",
    "perfect-freehand": "^1.2.3",
    "solid-js": "^1.9.3"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
