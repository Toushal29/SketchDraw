    "build": "vite build --configLoader native",
    "test:canvas": "node scripts/check-canvas-performance.mjs",
    "convert:sketch": "node scripts/convert-sketch.mjs",
    "serve": "vite preview",
    "tauri": "tauri"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "2.8.3",
