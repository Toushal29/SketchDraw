<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI">
  <bpmn:process id="NestedProcess" isExecutable="false">
    <bpmn:subProcess id="Nested" name="Nested flow" triggeredByEvent="false">
      <bpmn:startEvent id="NestedStart" name="Begin" />
      <bpmn:task id="NestedTask" name="Work" />
      <bpmn:endEvent id="NestedEnd" name="Finish" />
      <bpmn:sequenceFlow id="NestedFlow1" sourceRef="NestedStart" targetRef="NestedTask" />
      <bpmn:sequenceFlow id="NestedFlow2" sourceRef="NestedTask" targetRef="NestedEnd" />
    </bpmn:subProcess>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="NestedDiagram">
    <bpmndi:BPMNPlane id="NestedPlane" bpmnElement="NestedProcess">
      <bpmndi:BPMNShape id="DI_Nested" bpmnElement="Nested"><dc:Bounds x="40" y="40" width="360" height="220" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_NestedStart" bpmnElement="NestedStart"><dc:Bounds x="70" y="110" width="48" height="48" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_NestedTask" bpmnElement="NestedTask"><dc:Bounds x="180" y="96" width="110" height="72" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_NestedEnd" bpmnElement="NestedEnd"><dc:Bounds x="320" y="110" width="48" height="48" /></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="DI_NestedFlow1" bpmnElement="NestedFlow1"><di:waypoint x="118" y="134" /><di:waypoint x="180" y="132" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DI_NestedFlow2" bpmnElement="NestedFlow2"><di:waypoint x="290" y="132" /><di:waypoint x="320" y="134" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
